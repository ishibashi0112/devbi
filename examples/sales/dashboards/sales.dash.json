{
  "title": "売上ダッシュボード",
  "description": "サンプルデータ（data/sales.xlsx の「明細」シート）",
  "metrics": "sales",
  "tiles": [
    {
      "id": "period",
      "x": 0, "y": 0, "w": 12, "h": 1,
      "type": "date-range",
      "options": { "default": "latest_fiscal_year" }
    },
    {
      "id": "kpi-revenue",
      "x": 0, "y": 1, "w": 3, "h": 2,
      "type": "kpi",
      "title": "売上",
      "query": { "measures": ["revenue", "revenue_ly", "revenue_yoy"] }
    },
    {
      "id": "kpi-orders",
      "x": 3, "y": 1, "w": 3, "h": 2,
      "type": "kpi",
      "title": "受注件数",
      "query": { "measures": ["orders"] }
    },
    {
      "id": "kpi-avg",
      "x": 6, "y": 1, "w": 3, "h": 2,
      "type": "kpi",
      "title": "平均受注額",
      "query": { "measures": ["avg_order"] }
    },
    {
      "id": "kpi-qty",
      "x": 9, "y": 1, "w": 3, "h": 2,
      "type": "kpi",
      "title": "数量",
      "query": { "measures": ["quantity"] }
    },
    {
      "id": "monthly",
      "x": 0, "y": 3, "w": 8, "h": 4,
      "type": "bar",
      "title": "月別売上",
      "query": { "measures": ["revenue"], "time": "month" }
    },
    {
      "id": "region",
      "x": 8, "y": 3, "w": 4, "h": 4,
      "type": "barlist",
      "title": "地域別売上",
      "query": { "measures": ["revenue"], "dimensions": ["region"] }
    },
    {
      "id": "vs-last-year",
      "x": 0, "y": 7, "w": 6, "h": 4,
      "type": "line",
      "title": "売上と前年同月",
      "query": { "measures": ["revenue", "revenue_ly"], "time": "month" }
    },
    {
      "id": "category-trend",
      "x": 6, "y": 7, "w": 6, "h": 4,
      "type": "area",
      "title": "商品分類別の推移",
      "query": { "measures": ["revenue"], "dimensions": ["category"], "time": "month" }
    },
    {
      "id": "top-customers",
      "x": 0, "y": 11, "w": 4, "h": 5,
      "title": "上位顧客（自作タイル）",
      "component": "./sales/TopCustomers.tsx"
    },
    {
      "id": "region-quarter",
      "x": 4, "y": 11, "w": 8, "h": 5,
      "type": "pivot",
      "title": "地域 × 四半期",
      "query": { "measures": ["revenue"], "dimensions": ["region"], "time": "quarter" },
      "options": { "columns": "受注日" }
    },
    {
      "id": "category",
      "x": 0, "y": 16, "w": 3, "h": 5,
      "type": "select",
      "title": "商品分類",
      "query": { "dimensions": ["category"], "measures": ["revenue"] }
    },
    {
      "id": "products",
      "x": 3, "y": 16, "w": 9, "h": 5,
      "type": "table",
      "title": "商品別",
      "query": {
        "measures": ["revenue", "revenue_yoy", "quantity", "orders"],
        "dimensions": ["category", "product"],
        "limit": 100
      }
    },
    {
      "id": "about",
      "x": 0, "y": 21, "w": 12, "h": 1,
      "type": "markdown",
      "options": {
        "text": "**このダッシュボードについて** グラフや表をクリックすると、ほかのタイルがその値で絞り込まれます。データは `data/sales.xlsx` を置き換えると更新されます。「上位顧客」は `dashboards/sales/TopCustomers.tsx` に JSX で書いたタイルです。"
      }
    }
  ]
}
