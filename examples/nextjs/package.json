{
  "name": "devbi-example-nextjs",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-dashboards": "node scripts/copy-dashboards.mjs",
    "predev": "node scripts/copy-dashboards.mjs",
    "dev": "next dev --port 3000 --hostname 127.0.0.1",
    "prebuild": "node scripts/copy-dashboards.mjs",
    "build": "next build",
    "start": "next start --port 3000 --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "e2e": "pnpm run build && playwright test --trace off"
  },
  "dependencies": {
    "@devbi/server": "workspace:*",
    "mssql": "^12.7.14",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~6.0.3"
  }
}
