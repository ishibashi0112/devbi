{
  "name": "devbi",
  "version": "0.0.0",
  "description": "BI for developers: dashboards as files in git, tiles as JSX, DuckDB in the browser.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ishibashi0112/devbi.git",
    "directory": "packages/devbi"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./schema/*": "./schema/*"
  },
  "files": [
    "dist",
    "schema"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^9.0.0"
  }
}
