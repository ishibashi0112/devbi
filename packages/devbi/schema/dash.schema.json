{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "エディタ用の JSON Schema の場所",
      "type": "string"
    },
    "title": {
      "description": "ダッシュボードの見出し。既定はファイル名",
      "type": "string"
    },
    "description": {
      "description": "見出しの横の説明",
      "type": "string"
    },
    "metrics": {
      "type": "string",
      "minLength": 1,
      "description": "タイルが使う指標ファイルの名前（models/<名前>.metrics.yaml）。1 つだけなら省略可"
    },
    "columns": {
      "description": "グリッドの列数。既定は 12",
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "rowHeight": {
      "description": "1 行の高さ（px）。既定は 80",
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "params": {
      "description": "パラメーター（見出しの下の欄）。キーはパラメーターの名前。書いた順に並ぶ",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "description": "型。text・integer・number・date・datetime・boolean。複数の値は text[] のように。-- param: と違うとエラー",
            "type": "string",
            "pattern": "^(text|integer|number|date|datetime|boolean)(\\[\\])?$"
          },
          "label": {
            "description": "欄の見出し。既定は -- param: の label か名前",
            "type": "string"
          },
          "default": {
            "description": "最初の値。日付は today・month_start・fiscal_year_start（-30 のように日数をずらせる）、候補の全部は all、複数の値は配列",
            "anyOf": [
              {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            ]
          },
          "values": {
            "description": "候補にするデータセット（api/<名前>.sql）の名前。1 列目が値、2 列目が表示",
            "type": "string",
            "minLength": 1
          },
          "optional": {
            "description": "空（NULL）でもよい",
            "type": "boolean"
          },
          "hidden": {
            "description": "欄に出さない（URL・埋め込み・React からは入る）",
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "description": "ダッシュボードのパラメーター。-- param: の行より勝つ"
      }
    },
    "fiscalYearStart": {
      "description": "既定値の fiscal_year_start が使う、年度の始まりの月（1〜12）。既定は 1",
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "apply": {
      "description": "auto（既定）: 値が決まったらすぐ読み直す。button: 「表示」を押したときに読む（重い SQL のダッシュボード向け）",
      "type": "string",
      "enum": [
        "auto",
        "button"
      ]
    },
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "タイルの名前。ダッシュボードの中で重複できない"
          },
          "x": {
            "type": "integer",
            "minimum": 0,
            "description": "左端の列（0 から）"
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "description": "上端の行（0 から）"
          },
          "w": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "幅（列の数）"
          },
          "h": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "高さ（行の数）"
          },
          "title": {
            "description": "タイルの見出し",
            "type": "string"
          },
          "type": {
            "description": "組み込みタイルの種類。component とどちらか一つ",
            "type": "string",
            "enum": [
              "kpi",
              "bar",
              "line",
              "area",
              "barlist",
              "table",
              "pivot",
              "explore",
              "select",
              "date-range",
              "markdown"
            ],
            "enumDescriptions": [
              "大きな数字。最初の指標を大きく、残りの指標をその下に出す。比較の指標は良し悪しで色が付く（better: lower の指標は減ると良い）",
              "棒グラフ。横軸は time、なければ最初の軸。2 つ目の軸か 2 つ目以降の指標は色分けの系列。棒をクリックで選択",
              "折れ線グラフ。軸の決め方は bar と同じ。点をクリックで選択",
              "積み上げ面グラフ。軸の決め方は bar と同じ。系列は大きい順に積む",
              "横棒のランキング。最初の軸を最初の指標で並べる。行をクリックで選択",
              "表。すべての列を出す。見出しで並べ替え、行をクリックでその行の軸の値を選択。データセット（query.dataset）の表は、options で列・グループ・合計・検索・行のクリックを決められ、列の見出しのメニューで絞り込める",
              "クロス集計。1 つの項目を列に、残りの軸を行に、最初の指標をセルに。合計の行と列つき",
              "指標ファイルの model の行（明細）を、見る人が自由に並べて集計する表とグラフ（Perspective）。期間やほかのタイルの選択で絞る。query は metrics・filters・limit（既定は 100,000 行）・period だけ",
              "最初の軸の値の一覧から選ぶ。9 件以上で検索欄が出る",
              "期間の選択。time の列を持つ指標ファイルのタイルを絞る（query.period が false のタイルは除く）。主な期間はボタン、ほかは「ほかの期間」から。query は書かない",
              "文章。**太字**、*斜体*、`コード`、[リンク](URL)、# 見出し、- 箇条書き。query は書かない"
            ]
          },
          "component": {
            "description": "自作タイル（dashboards/ の中の .tsx / .jsx）。dash.json からの相対パス。type とどちらか一つ",
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "object",
            "properties": {
              "metrics": {
                "type": "string",
                "minLength": 1,
                "description": "使う指標ファイルの名前（models/<名前>.metrics.yaml）。既定はダッシュボードの metrics"
              },
              "measures": {
                "description": "出す指標",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "指標の名前"
                }
              },
              "dimensions": {
                "description": "分ける軸",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "軸の名前"
                }
              },
              "time": {
                "description": "時間の粒度。day / week（月曜始まり）/ month / quarter / year / fiscal_year。結果の列名は time の列名",
                "type": "string",
                "enum": [
                  "day",
                  "week",
                  "month",
                  "quarter",
                  "year",
                  "fiscal_year"
                ]
              },
              "filters": {
                "description": "このタイルだけに常にかける絞り込み",
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "field": {
                          "type": "string",
                          "minLength": 1,
                          "description": "軸の名前か、time の列名"
                        },
                        "in": {
                          "type": "array",
                          "items": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ]
                          },
                          "description": "どれかに一致する行。null は空欄に一致"
                        }
                      },
                      "required": [
                        "field",
                        "in"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "field": {
                          "type": "string",
                          "minLength": 1,
                          "description": "軸の名前か、time の列名"
                        },
                        "between": {
                          "type": "array",
                          "items": [
                            {
                              "type": [
                                "string",
                                "number",
                                "boolean",
                                "null"
                              ]
                            },
                            {
                              "type": [
                                "string",
                                "number",
                                "boolean",
                                "null"
                              ]
                            }
                          ],
                          "additionalItems": false,
                          "minItems": 2,
                          "maxItems": 2,
                          "description": "[始まり, 終わり]。始まり ≦ 値 ＜ 終わり。null の側は無制限"
                        },
                        "unit": {
                          "description": "期間の単位（month など）。previous_period の比較は、同じ日数ではなく、この単位で 1 つ前（前の月の同じ日）",
                          "type": "string",
                          "enum": [
                            "day",
                            "week",
                            "month",
                            "quarter",
                            "year",
                            "fiscal_year"
                          ]
                        }
                      },
                      "required": [
                        "field",
                        "between"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "sort": {
                "description": "並べ替え。既定は時間の順、軸と指標があれば最初の指標の大きい順",
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "description": "列の名前。\"-revenue\" のように先頭に - で降順"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "field": {
                          "type": "string",
                          "minLength": 1,
                          "description": "列の名前"
                        },
                        "desc": {
                          "description": "true で降順",
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "field"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "limit": {
                "description": "最大の行数",
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "period": {
                "description": "false で、期間（date-range や時間のクリックでの選択）で絞らない",
                "type": "boolean"
              },
              "malloy": {
                "description": "指標と軸の名前で言えない集計を Malloy で書く（run: sales -> { group_by: 地域; aggregate: 売上 is 金額.sum() }）。指標ファイルの名前が、その明細の行（期間と選択で絞ったもの）。measures・dimensions・time・sort・limit とは一緒に使えない",
                "type": "string",
                "minLength": 1
              },
              "sql": {
                "description": "指標と軸の名前で言えない集計を SQL（DuckDB）で書く（SELECT 地域, SUM(金額) AS 売上 FROM sales GROUP BY 1）。FROM の指標ファイルの名前が、その明細の行（期間と選択で絞ったもの）。measures・dimensions・time・sort・limit とは一緒に使えない",
                "type": "string",
                "minLength": 1
              },
              "dataset": {
                "type": "string",
                "minLength": 1,
                "description": "データセット（サーバーの api/<名前>.sql）の名前。その結果の行をそのまま出す。パラメーターは見出しの下の欄から"
              },
              "params": {
                "description": "データセットのパラメーターに入れるもの。{ \"param\": \"ダッシュボードのパラメーター\" } か値。書かなければ同じ名前のダッシュボードのパラメーター",
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "param": {
                          "type": "string",
                          "minLength": 1,
                          "description": "ダッシュボードのパラメーターの名前"
                        }
                      },
                      "required": [
                        "param"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "anyOf": [
                        {
                          "type": [
                            "string",
                            "number",
                            "boolean",
                            "null"
                          ]
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": [
                              "string",
                              "number",
                              "boolean"
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            },
            "additionalProperties": false,
            "description": "何を出すか。指標と軸の名前で指定する。名前で言えない集計は malloy か sql で書く"
          },
          "options": {
            "description": "タイルの種類ごとの設定",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "x",
          "y",
          "w",
          "h"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "type"
            ]
          },
          {
            "required": [
              "component"
            ]
          }
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "kpi"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "options": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "bar"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "options": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "line"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "options": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "area"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "options": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "barlist"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "options": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "table"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "options": {
                  "type": "object",
                  "properties": {
                    "columns": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string",
                            "description": "列の名前（SQL の結果の列）"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "field": {
                                "type": "string",
                                "description": "列の名前（SQL の結果の列）"
                              },
                              "label": {
                                "type": "string",
                                "description": "見出し（既定は列の名前）"
                              },
                              "format": {
                                "type": "string",
                                "description": "数の書式（\"¥#,##0\"、\"#,##0\"、\"0.0%\" など）"
                              },
                              "width": {
                                "type": "number",
                                "minimum": 20,
                                "description": "幅（px）。書かなければ中身に合わせる"
                              },
                              "align": {
                                "enum": [
                                  "left",
                                  "center",
                                  "right"
                                ],
                                "description": "寄せ（既定は数が右、ほかは左）"
                              },
                              "pin": {
                                "enum": [
                                  "left",
                                  "right"
                                ],
                                "description": "左か右に固定（横にスクロールしても動かない）"
                              },
                              "hidden": {
                                "type": "boolean",
                                "description": "最初は隠す（見る人が列の一覧から出せる）"
                              },
                              "filter": {
                                "type": "boolean",
                                "description": "false で列の絞り込みを出さない"
                              },
                              "agg": {
                                "enum": [
                                  "sum",
                                  "avg",
                                  "min",
                                  "max",
                                  "count"
                                ],
                                "description": "グループと合計の行の集計（count は行の数）"
                              },
                              "style": {
                                "anyOf": [
                                  {
                                    "enum": [
                                      "bar",
                                      "scale"
                                    ],
                                    "description": "bar はデータバー、scale は色の濃さ"
                                  },
                                  {
                                    "type": "object",
                                    "properties": {
                                      "chips": {
                                        "type": "object",
                                        "additionalProperties": {
                                          "enum": [
                                            "neutral",
                                            "info",
                                            "good",
                                            "warning",
                                            "critical"
                                          ]
                                        },
                                        "description": "値ごとの色のチップ（{ \"遅れ\": \"critical\" }）"
                                      }
                                    },
                                    "required": [
                                      "chips"
                                    ],
                                    "additionalProperties": false
                                  }
                                ]
                              }
                            },
                            "required": [
                              "field"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      },
                      "description": "出す列と順（データセットの表）。列の名前か { \"field\": 列の名前, \"label\", \"format\", \"width\", \"align\", \"pin\", \"hidden\", \"filter\", \"agg\", \"style\" }。書かなければ全部の列を SQL の順に"
                    },
                    "groupBy": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ],
                      "description": "行をまとめる列（順に階層。[\"地域\", \"顧客\"]）。小計は agg の列（どの列にも agg がなければ数の列の合計）"
                    },
                    "totals": {
                      "type": "boolean",
                      "description": "表の下に合計の行（agg の列。どの列にも agg がなければ数の列の合計）。絞り込むと見えている行の合計"
                    },
                    "search": {
                      "type": "boolean",
                      "description": "上の検索欄（全部の列から探して絞る）。false で消す。既定は出す"
                    },
                    "click": {
                      "type": "object",
                      "properties": {
                        "params": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          },
                          "description": "パラメーターの名前 → 入れる列の名前"
                        }
                      },
                      "required": [
                        "params"
                      ],
                      "additionalProperties": false,
                      "description": "行をクリックすると、その行の列の値をダッシュボードのパラメーターに入れる: { \"params\": { \"customer\": \"顧客ID\" } }。もう一度クリックで既定値に戻す"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "pivot"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "options": {
                  "type": "object",
                  "properties": {
                    "columns": {
                      "type": "string",
                      "description": "列にする項目（軸の名前か time の列名）。既定は最後の軸か時間"
                    },
                    "totals": {
                      "type": "boolean",
                      "description": "false で合計の行と列を消す"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "explore"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "options": {
                  "type": "object",
                  "properties": {
                    "layout": {
                      "type": "object",
                      "description": "開いたときの並べ方（Perspective の設定）。group_by（行にする列）、split_by（列に分ける列）、columns（出す列）、aggregates（列ごとの集計: sum・count・distinct count・avg など）、sort、filter、plugin（Datagrid・Y Bar・Y Line・Heatmap など）"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "select"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "options": {
                  "type": "object",
                  "properties": {
                    "multiple": {
                      "type": "boolean",
                      "description": "false で 1 つだけ選ぶ（既定は複数）"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "date-range"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "options": {
                  "type": "object",
                  "properties": {
                    "default": {
                      "enum": [
                        "all",
                        "latest_day",
                        "last_7_days",
                        "last_30_days",
                        "latest_week",
                        "latest_month",
                        "previous_month",
                        "latest_quarter",
                        "previous_quarter",
                        "last_12_months",
                        "latest_year",
                        "previous_year",
                        "year_to_date",
                        "latest_fiscal_year",
                        "previous_fiscal_year"
