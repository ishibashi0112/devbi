{
  "name": "@devbi/vite",
  "version": "0.1.0",
  "description": "Vite plugin for DevBI: reads dashboards/ and models/, bundles promoted tiles, copies data files into the build.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ishibashi0112/devbi.git",
    "directory": "packages/vite"
  },
  "homepage": "https://github.com/ishibashi0112/devbi#readme",
  "bugs": "https://github.com/ishibashi0112/devbi/issues",
  "keywords": [
    "devbi",
    "bi",
    "dashboard",
    "vite-plugin"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "client.d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@devbi/server": "workspace:^",
    "devbi": "workspace:^",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@devbi/react": "workspace:^",
    "vite": ">=7"
  },
  "devDependencies": {
    "@devbi/react": "workspace:^",
    "@types/react": "^19.3.0",
    "tsup": "^9.0.0",
    "vite": "^8.3.6"
  },
  "bin": {
    "devbi-gen": "./bin/devbi-gen.js"
  },
  "publishConfig": {
    "access": "public"
  }
}
