{
  "name": "@devbi/server",
  "version": "0.1.0",
  "description": "DevBI's read-only API (SQL files on the server, Arrow to the browser) and devbi-serve: the built site and the API in one process.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ishibashi0112/devbi.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/ishibashi0112/devbi#readme",
  "bugs": "https://github.com/ishibashi0112/devbi/issues",
  "keywords": [
    "devbi",
    "bi",
    "api",
    "arrow",
    "sql"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "devbi-serve": "./bin/devbi-serve.js",
    "devbi-snapshot": "./bin/devbi-snapshot.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "apache-arrow": "^17.0.0",
    "devbi": "workspace:^"
  },
  "peerDependencies": {
    "mssql": ">=11",
    "mysql2": ">=3",
    "oracledb": ">=6",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "mssql": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "oracledb": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/oracledb": "^26.0.1",
    "@types/pg": "^8.15.0",
    "mssql": "^12.7.14",
    "mysql2": "^3.24.6",
    "oracledb": "^26.0.0",
    "pg": "^8.16.0",
    "tsup": "^9.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
