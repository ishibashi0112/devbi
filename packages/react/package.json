{
  "name": "@devbi/react",
  "version": "0.0.0",
  "description": "DevBI runtime for React: DuckDB-wasm engine, built-in tiles and cross-filtering.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ishibashi0112/devbi.git",
    "directory": "packages/react"
