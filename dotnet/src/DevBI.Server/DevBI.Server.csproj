<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DevBI's read-only API (api/*.sql on SQL Server → Arrow) without ties to a web framework: DevBI.Server.AspNetCore
    and DevBI.Server.SystemWeb connect it to ASP.NET Core and to ASP.NET on .NET Framework. netstandard2.0 runs on
    .NET Framework 4.7.2 and later.
  -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>DevBI.Server</RootNamespace>
    <Description>DevBI's read-only API in C#: SQL files on the server, SQL Server, Arrow to the browser.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Arrow" Version="23.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DevBI.Server.Tests" />
  </ItemGroup>

</Project>
