node_modules/
dist/
# The documentation site's cache (pnpm docs:build / docs:dev; the site itself goes to docs/.vitepress/dist/)
docs/.vitepress/cache/
# pnpm gen / the Vite plugin writes these from models/ and api/ (they include local_* names, so keep them out of
# git), except columns.json (the datasets' columns as their databases answered): kept, so a machine without the
# database (CI, a colleague) gets the same row types
**/.devbi/*
!**/.devbi/columns.json
*.tsbuildinfo
.vite/
test-results/
playwright-report/
.DS_Store
# The build copies docs/reference.md into the devbi package (edit docs/reference.md)
packages/devbi/docs/
# 本物の接続先（パスワードを含む）を書く .env.local は git に入れない
.env*.local

# 自分の Excel で試すときのファイル（pnpm try-xlsx が作る）。git に入れない
examples/*/data/local/
examples/*/models/local_*
examples/*/dashboards/local_*

# e2e/editor.spec.ts の GUI エディタが書き込む作業用のコピー
examples/*/e2e-work/

# examples/oss の数字（scripts/fetch-stats.mjs か fixture.mjs が書く）
examples/oss/data/
