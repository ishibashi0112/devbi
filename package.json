{
  "name": "devbi-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "example:dev": "pnpm build && pnpm --filter devbi-example-sales dev",
    "example:build": "pnpm build && pnpm --filter devbi-example-sales build",
    "example:preview": "pnpm example:build && pnpm --filter devbi-example-sales preview",
    "example:serve": "pnpm example:build && pnpm --filter devbi-example-sales serve",
    "example:nextjs": "pnpm example:build && pnpm --filter devbi-example-nextjs build && pnpm --filter devbi-example-nextjs start",
    "example:check": "pnpm build && pnpm --filter devbi-example-sales check",
    "demo:fetch": "pnpm --filter devbi-example-oss fetch",
    "demo:dev": "pnpm build && pnpm --filter devbi-example-oss dev",
    "try-xlsx": "pnpm build && pnpm --filter devbi-example-sales try-xlsx",
    "gen": "pnpm build && pnpm --filter devbi-example-sales gen",
    "e2e": "pnpm build && pnpm --filter devbi-example-sales e2e",
    "e2e:nextjs": "pnpm example:build && pnpm --filter devbi-example-nextjs e2e",
    "check:packed": "pnpm build && node scripts/check-packed.mjs"
  },
  "devDependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "@types/node": "^22.19.0",
    "ajv": "^8.20.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
